func listMountBoundariesTx(ctx context.Context, runner sqlTxRunner) ([]string, error) {
	rows, err := runner.QueryContext(ctx, `SELECT path FROM mount_boundaries ORDER BY path`)
	if err != nil {
		return nil, fmt.Errorf("sync: listing mount boundaries: %w", err)
	}
	defer rows.Close() //nolint:errcheck // read-only cursor; iteration errors are reported by rows.Err

	var paths []string
	for rows.Next() {
		var boundary string
		if err := rows.Scan(&boundary); err != nil {
			return nil, fmt.Errorf("sync: scanning mount boundary: %w", err)
		}
		paths = append(paths, boundary)
	}
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("sync: iterating mount boundaries: %w", err)
	}
	return paths, nil
}
internal/sync/store_pending_creates.go:508: 508-528 lines are duplicate of `internal/sync/store_local_state.go:536-555` (dupl)
func listRecordedItemPathsTx(ctx context.Context, tx sqlTxRunner) ([]string, error) {
	rows, err := tx.QueryContext(ctx, `SELECT path FROM pending_creates WHERE item_id <> '' ORDER BY path`)
	if err != nil {
		return nil, fmt.Errorf("sync: listing the records of created items: %w", err)
	}
	defer rows.Close() //nolint:errcheck // read-only cursor; iteration errors are reported by rows.Err

	var paths []string
	for rows.Next() {
		var path string
		if err := rows.Scan(&path); err != nil {
			return nil, fmt.Errorf("sync: reading the record of a created item: %w", err)
		}
		paths = append(paths, path)
	}
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("sync: listing the records of created items: %w", err)
	}

	return paths, nil
}
